//http-сервис приема заказов из внешних систем (Telegram-боты, веб-сайты)
//Метод: POST /orders

Функция ЗаказыPOST(Запрос)
	
	Попытка
		СтрокаТела = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаТела);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		Возврат СформироватьОтветJSON(400, Новый Структура("ok, error", Ложь, "Invalid JSON payload"));
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Структура") 
		Или НЕ Данные.Свойство("phone") 
		Или НЕ Данные.Свойство("items") 
		Или ТипЗнч(Данные.items) <> Тип("Массив") 
		Или Данные.items.Количество() = 0 Тогда
		
		Возврат СформироватьОтветJSON(422, Новый Структура("ok, error", Ложь, "Missing or empty required fields: phone, items"));
	КонецЕсли;
	
	ТелефонЧистый = ОчиститьТелефон(СокрЛП(Строка(Данные.phone)));
	Если ПустаяСтрока(ТелефонЧистый) Тогда
		Возврат СформироватьОтветJSON(422, Новый Структура("ok, error", Ложь, "Invalid phone number"));
	КонецЕсли;
	
	ИмяКлиента = "";
	Данные.Свойство("client_name", ИмяКлиента);
	
	ВнешнийИД = "";
	Данные.Свойство("external_id", ВнешнийИД);
	
	// Собираем коды SKU для пакетного поиска одним запросом (без N+1 в цикле)
	МассивКодов = Новый Массив;
	Для Каждого СтрТовара Из Данные.items Цикл
		Если ТипЗнч(СтрТовара) = Тип("Структура") И СтрТовара.Свойство("sku") Тогда
			МассивКодов.Добавить(СокрЛП(Строка(СтрТовара.sku)));
		КонецЕсли;
	КонецЦикла;
	
	КартаНоменклатуры = ПолучитьНоменклатуруПоКодам(МассивКодов);
	
	НачатьТранзакцию();
	Попытка
		Клиент = НайтиИлиСоздатьКлиента(ТелефонЧистый, СокрЛП(Строка(ИмяКлиента)));
		
		Док = Документы.ЗаказКлиента.СоздатьДокумент();
		Док.Дата = ТекущаяДатаСеанса();
		Док.Контрагент = Клиент;
		Док.Комментарий = "Заказ из бота/сайта" + ?(ЗначениеЗаполнено(ВнешнийИД), " #" + ВнешнийИД, "");
		
		Для Каждого СтрТовара Из Данные.items Цикл
			Если ТипЗнч(СтрТовара) <> Тип("Структура") Или НЕ СтрТовара.Свойство("sku") Тогда
				Продолжить;
			КонецЕсли;
			
			КодТовара = СокрЛП(Строка(СтрТовара.sku));
			Ном = КартаНоменклатуры.Получить(КодТовара);
			Если НЕ ЗначениеЗаполнено(Ном) Тогда
				Продолжить;
			КонецЕсли;
			
			Количество = ?(СтрТовара.Свойство("qty"), Число(СтрТовара.qty), 0);
			Цена = ?(СтрТовара.Свойство("price"), Число(СтрТовара.price), 0);
			
			Если Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтр = Док.Товары.Добавить();
			НоваяСтр.Номенклатура = Ном;
			НоваяСтр.Количество = Количество;
			НоваяСтр.Цена = Цена;
			НоваяСтр.Сумма = Количество * Цена;
		КонецЦикла;
		
		Если Док.Товары.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			Возврат СформироватьОтветJSON(422, Новый Структура("ok, error", Ложь, "No valid items found in nomenclature"));
		КонецЕсли;
		
		Док.Записать(РежимЗаписиДокумента.Запись);
		ЗафиксироватьТранзакцию();
		
		ДанныеОтвета = Новый Структура("ok, order_num", Истина, СокрЛП(Док.Номер));
		Возврат СформироватьОтветJSON(200, ДанныеОтвета);
		
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЗаписьЖурналаРегистрации("API_Orders", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат СформироватьОтветJSON(500, Новый Структура("ok, error", Ложь, "Internal server error"));
	КонецПопытки;
	
КонецФункции

Функция ПолучитьНоменклатуруПоКодам(МассивКодов)
	
	СоответствиеНоменклатуры = Новый Соответствие;
	Если МассивКодов.Количество() = 0 Тогда
		Возврат СоответствиеНоменклатуры;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Код КАК Код,
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Код В (&МассивКодов)
		|	И НЕ Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СоответствиеНоменклатуры.Вставить(СокрЛП(Выборка.Код), Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СоответствиеНоменклатуры;
	
КонецФункции

Функция НайтиИлиСоздатьКлиента(Телефон, ИмяКлиента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Наименование ПОДОБНО &Поиск
		|	И НЕ Контрагенты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Поиск", "%" + Телефон + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НовыйКлиент = Справочники.Контрагенты.СоздатьЭлемент();
	НовыйКлиент.Наименование = ?(ЗначениеЗаполнено(ИмяКлиента), ИмяКлиента + " (" + Телефон + ")", Телефон);
	НовыйКлиент.Записать();
	
	Возврат НовыйКлиент.Ссылка;
	
КонецФункции

Функция ОчиститьТелефон(Телефон)
	
	Результат = "";
	ДопустимыеСимволы = "0123456789";
	Для Индекс = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, Индекс, 1);
		Если СтрНайти(ДопустимыеСимволы, Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция СформироватьОтветJSON(КодСостояния, СтруктураДанных)
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, СтруктураДанных);
	
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
	Возврат Ответ;
	
КонецФункции

